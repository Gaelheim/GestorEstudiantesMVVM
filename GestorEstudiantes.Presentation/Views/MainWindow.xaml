<!-- =========================================================================
     CAPA PRESENTATION — VISTA PRINCIPAL (MainWindow.xaml)
     Esta ventana forma parte de la interfaz gráfica desarrollada con WPF.
     Utiliza el patrón MVVM: muestra la información al usuario y envía sus
     acciones al MainViewModel mediante enlaces de datos (Binding) y comandos.
     ========================================================================= -->
<Window x:Class="GestorEstudiantes.Presentation.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Gestor de Estudiantes"
        Height="720"
        Width="980"
        MinHeight="640"
        MinWidth="820"
        Background="#F4F6F8"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI">

    <Window.Resources>
        <Style x:Key="EtiquetaFormularioStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#0A1D42" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>

        <Style x:Key="CampoTextoStyle" TargetType="TextBox">
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="BorderBrush" Value="#CBD5E1" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#E2E8F0" />
                    <Setter Property="Foreground" Value="#64748B" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="BotonPrimarioStyle" TargetType="Button">
            <Setter Property="Background" Value="#00549E" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Padding" Value="18,7" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <Style x:Key="BotonSecundarioStyle" TargetType="Button">
            <Setter Property="Background" Value="#64748B" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Padding" Value="16,7" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <Style x:Key="BotonEliminarStyle" TargetType="Button">
            <Setter Property="Background" Value="#B91C1C" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Padding" Value="16,7" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.45" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <!-- 1. Encabezado -->
            <RowDefinition Height="Auto" />
            <!-- Contenido Principal -->
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 1. ENCABEZADO SUPERIOR -->
        <Border Grid.Row="0" Background="#0A1D42" Padding="24,16">
            <StackPanel>
                <TextBlock Text="Gestor de Estudiantes"
                           Foreground="White"
                           FontSize="22"
                           FontWeight="Bold" />
                <TextBlock Text="Sistema académico de gestión en memoria — Arquitectura MVVM, Clean, Onion y Hexagonal"
                           Foreground="#CBD5E1"
                           FontSize="12.5"
                           Margin="0,3,0,0" />
            </StackPanel>
        </Border>

        <!-- CONTENEDOR CENTRAL -->
        <Grid Grid.Row="1" Margin="20,16,20,16">
            <Grid.RowDefinitions>
                <!-- 2. Búsqueda -->
                <RowDefinition Height="Auto" />
                <!-- 3. Tabla de estudiantes -->
                <RowDefinition Height="*" />
                <!-- 4. Formulario y botones -->
                <RowDefinition Height="Auto" />
                <!-- 5. Barra de mensajes -->
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 2. SECCIÓN DE BÚSQUEDA -->
            <Border Grid.Row="0"
                    Background="White"
                    BorderBrush="#E2E8F0"
                    BorderThickness="1"
                    CornerRadius="4"
                    Padding="14,10"
                    Margin="0,0,0,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               Text="Buscar (Matrícula, Nombre o Apellido):"
                               VerticalAlignment="Center"
                               Foreground="#0A1D42"
                               FontWeight="SemiBold"
                               FontSize="13"
                               Margin="0,0,12,0" />

                    <TextBox Grid.Column="1"
                             Style="{StaticResource CampoTextoStyle}"
                             Text="{Binding TextoBusqueda, UpdateSourceTrigger=PropertyChanged}"
                             Margin="0,0,10,0" />

                    <Button Grid.Column="2"
                            Content="Limpiar búsqueda"
                            Style="{StaticResource BotonSecundarioStyle}"
                            Command="{Binding LimpiarBusquedaCommand}" />
                </Grid>
            </Border>

            <!-- 3. TABLA DE ESTUDIANTES (DataGrid) -->
            <Border Grid.Row="1"
                    Background="White"
                    BorderBrush="#E2E8F0"
                    BorderThickness="1"
                    CornerRadius="4"
                    Padding="10"
                    Margin="0,0,0,12">
                <DataGrid ItemsSource="{Binding EstudiantesView}"
                          SelectedItem="{Binding EstudianteSeleccionado, Mode=TwoWay}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          SelectionMode="Single"
                          SelectionUnit="FullRow"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal"
                          HorizontalGridLinesBrush="#E2E8F0"
                          RowHeight="32"
                          ColumnHeaderHeight="34"
                          FontSize="13"
                          Background="White"
                          BorderThickness="0">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Matrícula"
                                            Binding="{Binding Matricula}"
                                            Width="130" />
                        <DataGridTextColumn Header="Nombre"
                                            Binding="{Binding Nombre}"
                                            Width="*" />
                        <DataGridTextColumn Header="Apellido"
                                            Binding="{Binding Apellido}"
                                            Width="*" />
                        <DataGridTextColumn Header="Correo electrónico"
                                            Binding="{Binding CorreoElectronico}"
                                            Width="1.4*" />
                        <DataGridTextColumn Header="Carrera"
                                            Binding="{Binding Carrera}"
                                            Width="1.2*" />
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <!-- 4. FORMULARIO Y BOTONES -->
            <Border Grid.Row="2"
                    Background="White"
                    BorderBrush="#E2E8F0"
                    BorderThickness="1"
                    CornerRadius="4"
                    Padding="16,14"
                    Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="{Binding TituloFormulario}"
                               Foreground="#00549E"
                               FontSize="15"
                               FontWeight="Bold"
                               Margin="0,0,0,12" />

                    <!-- Campos del formulario en cuadrícula -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="10" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Matrícula -->
                        <StackPanel Grid.Row="0" Grid.Column="0">
                            <TextBlock Text="Matrícula" Style="{StaticResource EtiquetaFormularioStyle}" />
                            <TextBox Style="{StaticResource CampoTextoStyle}"
                                     Text="{Binding Matricula, UpdateSourceTrigger=PropertyChanged}"
                                     IsEnabled="{Binding MatriculaHabilitada}" />
                        </StackPanel>

                        <!-- Nombre -->
                        <StackPanel Grid.Row="0" Grid.Column="2">
                            <TextBlock Text="Nombre" Style="{StaticResource EtiquetaFormularioStyle}" />
                            <TextBox Style="{StaticResource CampoTextoStyle}"
                                     Text="{Binding Nombre, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>

                        <!-- Apellido -->
                        <StackPanel Grid.Row="0" Grid.Column="4">
                            <TextBlock Text="Apellido" Style="{StaticResource EtiquetaFormularioStyle}" />
                            <TextBox Style="{StaticResource CampoTextoStyle}"
                                     Text="{Binding Apellido, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>

                        <!-- Correo electrónico -->
                        <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3">
                            <TextBlock Text="Correo electrónico" Style="{StaticResource EtiquetaFormularioStyle}" />
                            <TextBox Style="{StaticResource CampoTextoStyle}"
                                     Text="{Binding CorreoElectronico, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>

                        <!-- Carrera -->
                        <StackPanel Grid.Row="2" Grid.Column="4">
                            <TextBlock Text="Carrera" Style="{StaticResource EtiquetaFormularioStyle}" />
                            <TextBox Style="{StaticResource CampoTextoStyle}"
                                     Text="{Binding Carrera, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                    </Grid>

                    <!-- Botones de acción -->
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                Margin="0,14,0,0">
                        <Button Content="Guardar"
                                Style="{StaticResource BotonPrimarioStyle}"
                                Command="{Binding GuardarCommand}"
                                Margin="0,0,10,0" />

                        <Button Content="Limpiar"
                                Style="{StaticResource BotonSecundarioStyle}"
                                Command="{Binding LimpiarCommand}"
                                Margin="0,0,10,0" />

                        <Button Content="Eliminar"
                                Style="{StaticResource BotonEliminarStyle}"
                                Command="{Binding EliminarCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- 5. ESPACIO VISIBLE DE MENSAJES Y VALIDACIONES -->
            <Border Grid.Row="3"
                    CornerRadius="4"
                    Padding="14,10"
                    BorderThickness="1">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="#EBF5FF" />
                        <Setter Property="BorderBrush" Value="#93C5FD" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding EsError}" Value="True">
                                <Setter Property="Background" Value="#FEF2F2" />
                                <Setter Property="BorderBrush" Value="#FCA5A5" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>

                <TextBlock Text="{Binding Mensaje}"
                           FontSize="13"
                           FontWeight="SemiBold"
                           TextWrapping="Wrap">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="#0A1D42" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding EsError}" Value="True">
                                    <Setter Property="Foreground" Value="#991B1B" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Border>
        </Grid>
    </Grid>
</Window>
